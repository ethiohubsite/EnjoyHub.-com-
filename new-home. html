

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EthioHub | Connect & Discover</title>
<meta name="theme-color" content="#1877f2">
<style>
:root{--blue:#1877f2;--bg:#f0f2f5;--card:#fff;--text:#18202a;--muted:#667085;--line:#e4e7ec}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.topbar{position:sticky;top:0;z-index:20;background:var(--card);padding:12px 4%;display:flex;align-items:center;gap:16px;box-shadow:0 1px 5px #0001}
.brand{font-size:25px;font-weight:800;color:var(--blue);white-space:nowrap}
.search{flex:1;min-width:80px;border:0;background:var(--bg);padding:12px 16px;border-radius:24px;outline-color:var(--blue)}
.nav{display:flex;justify-content:center;gap:4px;background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:59px;z-index:15}
.nav button{flex:1;max-width:170px;border:0;background:none;padding:14px 4px;color:var(--muted);font-weight:bold;border-bottom:3px solid transparent}
.nav button.active{color:var(--blue);border-bottom-color:var(--blue)}
.layout{max-width:1050px;margin:22px auto;padding:0 14px;display:grid;grid-template-columns:210px minmax(0,620px);gap:20px}
.side{position:sticky;top:125px;align-self:start}
.side button{display:block;width:100%;text-align:left;background:transparent;border:0;border-radius:10px;padding:13px;font-weight:bold;color:var(--text)}
.side button:hover{background:#e3e7ed}
.main{min-width:0}
.card{background:var(--card);border-radius:13px;padding:16px;margin-bottom:16px;box-shadow:0 1px 3px #0000}
h2{font-size:19px;margin:0 0 14px}
h3{font-size:16px;margin:0}
.muted{color:var(--muted);font-size:13px}
.pill{border:0;border-radius:9px;padding:10px 14px;background:#e7f0ff;color:var(--blue);font-weight:bold}
.primary{background:var(--blue);color:white;border:0;border-radius:9px;padding:12px 16px;font-weight:bold}
.danger{background:#ff3155;color:white}
.field{display:block;width:100%;border:1px solid var(--line);border-radius:9px;padding:12px;margin:8px 0 12px;background:var(--card);color:var(--text)}
textarea.field{resize:vertical;min-height:75px}
.create-row{display:flex;gap:10px;align-items:center}
.avatar{width:40px;height:40px;flex-shrink:0;border-radius:50%;display:grid;place-items:center;background:#e7f0ff;color:var(--blue);font-weight:bold}
.create-input{border:0;border-radius:25px;background:var(--bg);padding:13px 16px;flex:1;min-width:0;text-align:left;color:var(--muted)}
.quick-actions{display:flex;gap:8px;border-top:1px solid var(--line);margin-top:14px;padding-top:12px}
.quick-actions button{flex:1;background:none;border:0;padding:8px 2px;color:var(--muted);font-weight:bold}
.quick-actions button:hover{background:var(--bg);border-radius:8px}
.post-head{display:flex;gap:10px;align-items:center;margin-bottom:12px}
.post-head .muted{margin-top:4px}
.post-text{line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere;margin:12px 0}
.post-media{width:100%;max-height:520px;object-fit:contain;border-radius:10px;background:#111;display:block}
.post-actions{display:flex;justify-content:space-around;gap:5px;border-top:1px solid var(--line);margin-top:12px;padding-top:10px}
.post-actions button{border:0;background:none;padding:9px 4px;border-radius:8px;flex:1;color:var(--muted);font-weight:bold}
.post-actions button:hover{background:var(--bg)}
.post-actions .liked{color:#e11d48}
.comments{margin-top:12px;display:none}
.comment-list{font-size:14px;line-height:1.5;margin-bottom:8px}
.comment-form{display:flex;gap:7px}
.comment-form input{min-width:0;flex:1;border:1px solid var(--line);border-radius:20px;padding:10px}
.category-row{display:flex;gap:8px;overflow:auto;margin-bottom:14px;padding-bottom:3px}
.category-row button{white-space:nowrap;border:0;border-radius:22px;padding:10px 15px;background:var(--card);font-weight:bold}
.category-row button.active{background:var(--blue);color:white}
.hidden{display:none!important}
#upload-preview{display:none;width:100%;max-height:380px;margin-top:12px;background:#111;border-radius:10px}
.notice{padding:12px;border-radius:9px;background:#fff7e6;color:#8a5700;font-size:13px;line-height:1.5}
.footer{text-align:center;color:var(--muted);font-size:12px;padding:25px}
@media(max-width:700px){
 .topbar{padding:10px;gap:9px}.brand{font-size:21px}
 .layout{display:block;margin:12px auto;padding:0 9px}
 .side{display:none}.nav{top:54px}
 .nav button{font-size:12px;padding:12px 2px}
 .card{padding:13px;border-radius:11px;margin-bottom:12px}
 .quick-actions button{font-size:12px}
}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand">EthioHub</div>
  <input class="search" id="search" placeholder="🔍 Search EthioHub..." aria-label="Search posts">
  <button class="pill" onclick="showPanel('profile')">👤</button>
</header>

<nav class="nav">
  <button class="active" data-view="home" onclick="showView('home',this)">🏠 Home</button>
  <button data-view="videos" onclick="showView('videos',this)">🎬 Videos</button>
  <button data-view="photos" onclick="showView('photos',this)">📸 Photos</button>
  <button data-view="profile" onclick="showView('profile',this)">👤 Profile</button>
</nav>

<div class="layout">
<aside class="side">
  <button onclick="showView('home')">🏠 Home Feed</button>
  <button onclick="showView('videos')">🎬 Video Feed</button>
  <button onclick="showView('photos')">📸 Photo Feed</button>
  <button onclick="showView('trending')">🔥 Trending</button>
  <button onclick="showPanel('upload')">➕ Create Post</button>
  <button onclick="showPanel('profile')">👤 My Profile</button>
  <button onclick="showPanel('login')">🔐 Login / Sign Up</button>
  <button onclick="showPanel('payment')">🔒 Video Access</button>
</aside>

<main class="main">
  <section id="home-view">
    <div class="card">
      <div class="create-row">
        <div class="avatar">EH</div>
        <button class="create-input" onclick="showPanel('upload')">What's on your mind?</button>
      </div>
      <div class="quick-actions">
        <button onclick="setUploadType('video')">🎬 Video</button>
        <button onclick="setUploadType('photo')">📸 Photo</button>
        <button onclick="setUploadType('text')">📝 Text</button>
      </div>
    </div>

    <div class="category-row" id="category-row">
      <button class="active" data-category="all" onclick="setCategory('all',this)">For You</button>
      <button data-category="trending" onclick="setCategory('trending',this)">🔥 Trending</button>
      <button data-category="comedy" onclick="setCategory('comedy',this)">😂 Comedy</button>
      <button data-category="technology" onclick="setCategory('technology',this)">💻 Technology</button>
      <button data-category="entertainment" onclick="setCategory('entertainment',this)">✨ Entertainment</button>
    </div>
  </section>

  <section id="videos-view" class="hidden">
    <div class="card"><h2>🎬 Videos</h2><p class="muted">Video posts appear here.</p></div>
  </section>
  <section id="photos-view" class="hidden">
    <div class="card"><h2>📸 Photos</h2><p class="muted">Photo posts appear here.</p></div>
  </section>
  <section id="trending-view" class="hidden">
    <div class="card"><h2>🔥 Trending</h2><p class="muted">Popular posts appear here.</p></div>
  </section>

  <section id="feed"></section>

  <section id="upload-panel" class="card hidden">
    <h2>➕ Create a Post</h2>
    <label for="post-type" class="muted">Post type</label>
    <select class="field" id="post-type" onchange="updateUploadInput()">
      <option value="text">📝 Text post</option>
      <option value="photo">📸 Photo</option>
      <option value="video">🎬 Video</option>
    </select>
    <label for="post-caption" class="muted">Caption or message</label>
    <textarea class="field" id="post-caption" maxlength="2000" placeholder="Write something..."></textarea>
    <label for="post-category" class="muted">Category</label>
    <select class="field" id="post-category">
      <option value="entertainment">Entertainment</option>
      <option value="comedy">Comedy</option>
      <option value="technology">Technology</option>
      <option value="trending">Trending</option>
      <option value="general">General</option>
    </select>
    <label for="post-file" class="muted">Choose photo or video (optional)</label>
    <input class="field" id="post-file" type="file" accept="image/*,video/*">
    <video id="upload-preview" controls playsinline></video>
    <img id="image-preview" class="post-media hidden" alt="Photo preview" style="margin-top:12px">
    <p id="upload-status" class="muted">Posts are saved in this browser only.</p>
    <button class="primary" onclick="publishPost()">Publish Post</button>
    <button class="pill" onclick="hidePanels()">Cancel</button>
  </section>

  <section id="profile-panel" class="card hidden">
    <h2>👤 My Profile</h2>
    <div class="create-row">
      <div class="avatar" style="width:60px;height:60px;font-size:20px">EH</div>
      <div><strong id="profile-name">EthioHub Member</strong><p class="muted">Your local profile preview</p></div>
    </div>
    <label class="muted" for="profile-edit-name">Display name</label>
    <input id="profile-edit-name" class="field" maxlength="50" placeholder="Your name">
    <label class="muted" for="profile-bio">About me</label>
    <textarea id="profile-bio" class="field" maxlength="250" placeholder="Write a short bio..."></textarea>
    <button class="primary" onclick="saveProfile()">Save Profile</button>
    <p class="notice">This profile is saved only in this browser. It is not a public account yet.</p>
  </section>

  <section id="login-panel" class="card hidden">
    <h2>🔐 Sign Up / Login</h2>
    <input class="field" id="account-name" maxlength="50" placeholder="Display name">
    <input class="field" id="account-email" type="email" placeholder="Email address">
    <input class="field" id="account-password" type="password" placeholder="Password (demo only)">
    <button class="primary" onclick="demoLogin()">Continue</button>
    <p id="login-status" class="muted"></p>
    <p class="notice">Demo only. Do not enter a real password. Real secure login must be connected to an authentication service.</p>
  </section>

  <section id="payment-panel" class="card hidden">
    <h2>🔒 Unlock a Video</h2>
    <p class="muted">Choose a video and payment method.</p>
    <input class="field" id="payment-video" placeholder="Video title">
    <select class="field" id="payment-method">
      <option value="">Choose payment method</option>
      <option>Telebirr</option>
      <option>Visa / Mastercard</option>
      <option>Wegagen Bank</option>
      <option>Other bank transfer</option>
    </select>
    <button class="primary" onclick="paymentRequest()">Continue</button>
    <p id="payment-status" class="muted">Checkout is not connected yet. No payment will be taken.</p>
    <div class="notice">Never enter card details on this demo page. Online payment needs a verified gateway and secure server-side payment confirmation.</div>
  </section>
</main>
</div>

<footer class="footer">EthioHub • Connect • Share • Discover</footer>

<script>
(function(){
"use strict";
const $=id=>document.getElementById(id);
let posts=[];
let currentCategory="all";
let currentView="home";
let selectedFile=null;
let objectUrls=[];
let profile={name:"EthioHub Member",bio:""};
let searchTerm="";

function loadLocal(){
  try{
    posts=JSON.parse(localStorage.getItem("eh_posts")||"[]");
    profile=JSON.parse(localStorage.getItem("eh_profile")||'{"name":"EthioHub Member","bio":""}');
  }catch(e){posts=[];profile={name:"EthioHub Member",bio:""}}
  $("profile-name").textContent=profile.name||"EthioHub Member";
  $("profile-edit-name").value=profile.name||"";
  $("profile-bio").value=profile.bio||"";
}
function saveLocal(){
  try{
    localStorage.setItem("eh_posts",JSON.stringify(posts));
    return true;
  }catch(e){
    $("upload-status").textContent="Browser storage is full. Large videos cannot be saved this way.";
    return false;
  }
}
window.showPanel=function(name){
  ["upload","profile","login","payment"].forEach(p=>$(`${p}-panel`).classList.toggle("hidden",p!==name));
  window.scrollTo({top:0,behavior:"smooth"});
};
window.hidePanels=function(){
  ["upload","profile","login","payment"].forEach(p=>$(`${p}-panel`).classList.add("hidden"));
};
window.showView=function(view,button){
  currentView=view;
  hidePanels();
  ["home","videos","photos","trending"].forEach(v=>{
    const el=$(v+"-view");
    if(el)el.classList.toggle("hidden",v!==view);
  });
  document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.view===view));
  renderPosts();
  if(view==="profile")showPanel("profile");
  if(button)button.classList.add("active");
};
window.setCategory=function(category,button){
  currentCategory=category;
  document.querySelectorAll("#category-row button").forEach(b=>b.classList.toggle("active",b===button));
  renderPosts();
};
window.setUploadType=function(type){
  $("post-type").value=type;
  updateUploadInput();
  showPanel("upload");
};
window.updateUploadInput=function(){
  const type=$("post-type").value;
  $("post-file").accept=type==="video"?"video/*":type==="photo"?"image/*":"image/*,video/*";
};
$("post-file").addEventListener("change",function(){
  const file=this.files&&this.files[0];
  selectedFile=file||null;
  $("upload-preview").style.display="none";
  $("upload-preview").removeAttribute("src");
  $("image-preview").classList.add("hidden");
  if(!file){$("upload-status").textContent="No file selected.";return;}
  if(file.size>20*1024*1024){
    $("upload-status").textContent="File is over 20 MB. Preview is available, but local saving may fail.";
  }else $("upload-status").textContent="Selected: "+file.name;
  const url=URL.createObjectURL(file);objectUrls.push(url);
  if(file.type.startsWith("video/")){
    $("upload-preview").src=url;$("upload-preview").style.display="block";
  }else if(file.type.startsWith("image/")){
    $("image-preview").src=url;$("image-preview").classList.remove("hidden");
  }
});
function safeText(s){
  return String(s||"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
window.publishPost=function(){
  const caption=$("post-caption").value.trim();
  const type=$("post-type").value;
  const category=$("post-category").value;
  if(!caption&&!selectedFile){$("upload-status").textContent="Add a message or choose a media file first.";return;}
  let mediaData="";
  if(selectedFile){
    if(selectedFile.size>4*1024*1024){
      $("upload-status").textContent="This local demo saves media only up to 4 MB. Larger files need cloud storage. Try a smaller file or text post.";
      return;
    }
    const reader=new FileReader();
    reader.onload=function(){
      addPost(caption,type,category,String(reader.result||""),selectedFile.type,selectedFile.name);
    };
    reader.onerror=function(){$("upload-status").textContent="Could not read this file. Try again.";};
    reader.readAsDataURL(selectedFile);
    $("upload-status").textContent="Preparing post...";
    return;
  }
  addPost(caption,type,category,mediaData,"","");
};
function addPost(caption,type,category,mediaData,mime,fileName){
  const post={id:Date.now()+"_"+Math.random().toString(36).slice(2,7),name:profile.name||"EthioHub Member",caption,type,category,mediaData,mime,fileName,likes:0,comments:[]};
  posts.unshift(post);
  if(!saveLocal()){posts.shift();return;}
  $("post-caption").value="";
  $("post-file").value="";
  selectedFile=null;
  $("upload-preview").style.display="none";
  $("upload-preview").removeAttribute("src");
  $("image-preview").classList.add("hidden");
  $("upload-status").textContent="Post saved in this browser.";
  hidePanels();
  showView("home");
}
function matches(post){
  const hay=(post.caption+" "+post.name+" "+post.category+" "+post.fileName).toLowerCase();
  if(searchTerm&&!hay.includes(searchTerm))return false;
  if(currentView==="videos"&&post.type!=="video")return false;
  if(currentView==="photos"&&post.type!=="photo")return false;
  if(currentView==="trending"&&post.likes<1)return false;
  if(currentCategory!=="all"&&post.category!==currentCategory)return false;
  return true;
}
function renderPosts(){
  const feed=$("feed");
  feed.innerHTML="";
  const shown=posts.filter(matches);
  if(!shown.length){
    const empty=document.createElement("div");
    empty.className="card";
    empty.innerHTML="<h3>No posts to show yet</h3><p class='muted'>Create a post above to see it in your feed. Posts are stored in this browser only.</p>";
    feed.appendChild(empty);
    return;
  }
  shown.forEach(post=>{
    const article=document.createElement("article");
    article.className="card";
    const media=post.mediaData
      ?post.type==="video"
        ?`<video class="post-media" controls playsinline preload="metadata" src="${post.mediaData}"></video>`
        :`<img class="post-media" alt="Post photo" src="${post.mediaData}">`
      :"";
    article.innerHTML=`
      <div class="post-head"><div class="avatar">EH</div><div><strong>${safeText(post.name)}</strong><div class="muted">${safeText(post.category)} · ${safeText(post.fileName||"EthioHub post")}</div></div></div>
      ${post.caption?`<div class="post-text">${safeText(post.caption)}</div>`:""}
      ${media}
      <div class="post-actions">
        <button data-action="like" data-id="${post.id}">♡ Like (${post.likes})</button>
        <button data-action="comment" data-id="${post.id}">💬 Comment</button>
        <button data-action="share" data-id="${post.id}">↗ Share</button>
      </div>
      <div class="comments" id="comments-${post.id}">
        <div class="comment-list">${(post.comments||[]).map(c=>`<div>💬 ${safeText(c)}</div>`).join("")}</div>
        <div class="comment-form"><input id="comment-input-${post.id}" maxlength="500" placeholder="Write a comment..."><button class="pill" data-action="send-comment" data-id="${post.id}">Send</button></div>
      </div>`;
    feed.appendChild(article);
  });
}
$("feed").addEventListener("click",function(event){
  const btn=event.target.closest("button[data-action]");
  if(!btn)return;
  const post=posts.find(p=>p.id===btn.dataset.id);
  if(!post)return;
  const action=btn.dataset.action;
  if(action==="like"){post.likes++;saveLocal();renderPosts();}
  if(action==="comment"){
    const el=$("comments-"+post.id);el.style.display=el.style.display==="block"?"none":"block";
  }
  if(action==="send-comment"){
    const input=$("comment-input-"+post.id);
    if(input&&input.value.trim()){post.comments.push(input.value.trim());saveLocal();renderPosts();$("comments-"+post.id).style.display="block";}
  }
  if(action==="share"){
    const shareText=post.caption||"Check out this post on EthioHub!";
    if(navigator.share){navigator.share({title:"EthioHub",text:shareText,url:location.href}).catch(()=>{});}
    else if(navigator.clipboard){navigator.clipboard.writeText(location.href).then(()=>alert("Link copied! Share EthioHub with your friends."),()=>alert(shareText));}
    else alert(shareText+" — "+location.href);
  }
});
$("search").addEventListener("input",function(){
  searchTerm=this.value.trim().toLowerCase();
  renderPosts();
});
window.saveProfile=function(){
  profile.name=$("profile-edit-name").value.trim()||"EthioHub Member";
  profile.bio=$("profile-bio").value.trim();
  try{localStorage.setItem("eh_profile",JSON.stringify(profile));}catch(e){}
  $("profile-name").textContent=profile.name;
  alert("Profile saved in this browser.");
};
window.demoLogin=function(){
  const name=$("account-name").value.trim();
  if(!name){$("login-status").textContent="Please enter a display name.";return;}
  profile.name=name;
  $("profile-name").textContent=name;
  $("profile-edit-name").value=name;
  try{localStorage.setItem("eh_profile",JSON.stringify(profile));}catch(e){}
  $("login-status").textContent="Demo profile created in this browser only. Secure login is not connected.";
};
window.paymentRequest=function(){
  const video=$("payment-video").value.trim();
  const method=$("payment-method").value;
  $("payment-status").textContent=!video||!method
    ?"Enter a video title and choose a payment method."
    :"Selected "+method+" for '"+video+"'. Checkout is not connected; no payment has been made.";
};
loadLocal();
renderPosts();
})();
</script>
</body>
</html>
